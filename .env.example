# Copy to .env and fill in. The real .env is git-ignored -- never commit it.

# --- Local Postgres (docker-compose) -----------------------------------------
# Used by docker-compose.yaml and scripts/python/load_data.py

POSTGRES_CONTAINER_NAME=tesco_de_project

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tesco_data

POSTGRES_PORT=5432
# Only needed if Postgres is not on this machine; defaults to localhost.
# POSTGRES_HOST=localhost

# 🔴 CHANGE THIS to your actual mac username
POSTGRES_DATA_PATH=/Users/YOUR_MAC_USERNAME/Documents/databases
DATA_PATH=/Users/YOUR_DATA_PATH/data

# --- Supabase (hosted Postgres) ----------------------------------------------
# Used by scripts/python/load_supabase.py
# Find both under: Supabase dashboard -> Project Settings -> Database
#
# Leave the {SUPABASE_DB_PASSWORD} placeholder in the connection string as-is:
# the script substitutes it at runtime, so the password lives in one place only.
#
# Use the *Session pooler* URI. The direct connection below is IPv6-only, so it
# is unreachable from an IPv4-only network. The pooler is IPv4-compatible; note
# its username is postgres.<project-ref> and its host carries your own region.
# Session mode (port 5432) is preferred over transaction mode (6543) because the
# loader bulk-copies inside a single transaction.
#
# The aws-<n>- prefix and the region are both per-project: copy the host from the
# dashboard rather than assuming (e.g. aws-0-ap-northeast-1 for a Tokyo project).

SUPABASE_CONNECTION_STRING=postgresql://postgres.YOUR_PROJECT_REF:{SUPABASE_DB_PASSWORD}@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Direct connection (IPv6-only -- use the pooler above unless you have IPv6):
# SUPABASE_CONNECTION_STRING=postgresql://postgres:{SUPABASE_DB_PASSWORD}@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
