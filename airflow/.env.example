# Copy to .env and fill in. The real .env is git-ignored -- never commit it.
# (Covered by the root .gitignore's bare `.env` pattern, same as the repo
# root's own .env and dbt/profiles.yml.)

AIRFLOW_METADATA_CONTAINER_NAME=tesco_airflow_metadata
AIRFLOW_CONTAINER_NAME=tesco_airflow

AIRFLOW_PORT=8080

# Matches your host UID so files Airflow writes into the dags/logs/plugins/
# config mounts are not owned by root. On Linux, run `id -u` and use that
# value. On macOS with Docker Desktop this rarely matters, but the official
# image still expects it set -- 50000 (Airflow's own default UID) is a safe
# default here.
AIRFLOW_UID=50000

# No Databricks credentials here on purpose. The airflow container mounts
# ../dbt read-write, so it reads dbt/profiles.yml -- the same git-ignored
# file you already filled in for local dbt development. See "3. Where
# profiles.yml lives" in the README.
